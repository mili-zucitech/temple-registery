# ============================================================
# DEV SECRETS TEMPLATE — safe to commit (no real values)
# ============================================================
# 1. Copy this file:  cp dev-secrets.properties.example dev-secrets.properties
# 2. Fill in your real credentials in dev-secrets.properties
# 3. dev-secrets.properties is git-ignored and will never be committed
# ============================================================

# TiDB / MySQL
DB_USERNAME=your-db-username
DB_PASSWORD=your-db-password

# Gmail SMTP (or other provider)
SMTP_USERNAME=your-smtp-email@example.com
SMTP_PASSWORD=your-smtp-app-password

# AES encryption key (must be exactly 32 bytes)
APP_ENCRYPTION_KEY=replace-with-32-byte-secret-key!!

# HMAC signing key (must be exactly 32 bytes)
APP_HMAC_KEY=replace-with-32-byte-hmac-key!!!!!!
